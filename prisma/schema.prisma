generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id         String    @id @db.Uuid
  updated_at DateTime? @db.Timestamptz(6)
  username   String?   @unique
  full_name  String?
  avatar_url String?
  website    String?

  projects Project[]

  @@map("profiles") // coincide con el nombre en Supabase (minúsculas)
}

model Project {
  projectId   String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  color       String  @default("#6366f1")

  userId    String  @db.Uuid
  createdBy String // text, no uuid
  updatedBy String? // text, no uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  Profile @relation(fields: [userId], references: [id], onDelete: Restrict)
  tasks Task[]

  @@index([userId])
  @@map("Project")
}

model Task {
  taskId      String  @id @default(uuid()) @db.Uuid
  title       String
  description String?

  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(MEDIUM)

  userId    String  @db.Uuid
  createdBy String // text, no uuid
  updatedBy String? // text, no uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@map("Task")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
